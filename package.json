{
  "name": "dcl-bugtest-customFont",
  "version": "1.0.0",
  "description": "Minimal Font Awesome fontSrc debug scene (no UI kit)",
  "scripts": {
    "start": "sdk-commands start",
    "start:bundles": "sdk-commands start --asset-bundles",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.32.0",
    "@dcl/sdk": "latest"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}